# Nighthawk Omada Shim example configuration
# Copy to .env and edit locally. Never commit .env.

# Southbound mode: "netgear" for stock-firmware Netgear Nighthawk APs,
# or "openwrt" for the upstream OpenWrt device-agent backend.
OMADA_SOUTHBOUND=netgear

# Omada controller transport
OMADA_CONTROLLER_HOST=omada-controller.example.net
OMADA_DISCOVERY_PORT=29810
OMADA_MANAGE_PORT=29814
OMADA_LOCAL_DISCOVERY_PORT=0
OMADA_DISCOVERY_INTERVAL=5
OMADA_TCP_TIMEOUT=15
OMADA_INFORM_INTERVAL=3
OMADA_RECONNECT_DELAY=3
OMADA_MANAGED_RECONNECT_ATTEMPTS=3

# Controller and site identifiers (Controller ID: 32 hex chars, Site ID: 24 hex chars)
OMADA_CONTROLLER_ID=0123456789abcdef0123456789abcdef
OMADA_SITE_ID=0123456789abcdef01234567
OMADA_SITE_NAME=Default
OMADA_DEST_OMADAC_ID=

# Virtual Omada AP identity (use a distinct locally administered MAC per AP)
OMADA_DEVICE_MAC=02:00:00:00:00:01
OMADA_DEVICE_NAME=Nighthawk-AP-1
OMADA_DEVICE_MODEL=EAP770
OMADA_DEVICE_MODEL_VERSION=2.0
OMADA_DEVICE_HARDWARE_VERSION=2.0
OMADA_DEVICE_FIRMWARE_VERSION=1.0.0
OMADA_CUSTOMIZE_REGION=841

# Advertised IP. Set to your Nighthawk AP IP or leave 0.0.0.0 to let the
# controller infer the transport source.
OMADA_DEVICE_IP=192.0.2.10
OMADA_PUBLIC_IP_LOOKUP_URL=https://api.ipify.org
OMADA_PUBLIC_IP_LOOKUP_TIMEOUT=2

# Omada Site Device Account credentials (never written to the managed-state file)
OMADA_DEVICE_USERNAME=
OMADA_DEVICE_PASSWORD=
OMADA_DEVICE_CIPHER_TYPE=5

# ECSP protocol identity
OMADA_ECSP_VERSION=2.3.0
OMADA_ECSP_VER_CAP=2

# Controller management TLS (self-signed certificates are common on controllers)
OMADA_TLS_VERIFY=false
OMADA_TLS_CA_FILE=

# Fallback wired-uplink telemetry (used until dashboard link reads arrive)
OMADA_LAN_RATE=10000
OMADA_LAN_DUPLEX=1
OMADA_LAN_PORT=LAN

# Netgear Nighthawk Genie SOAP southbound (required when OMADA_SOUTHBOUND=netgear)
OMADA_NETGEAR_HOST=192.0.2.10
OMADA_NETGEAR_USERNAME=admin
OMADA_NETGEAR_PASSWORD=
OMADA_NETGEAR_CLIENT_TTL=30.0
OMADA_NETGEAR_STALE_TTL=180.0

# Optional physical LAN MAC for station ownership on sites with multiple NETGEAR APs
# OMADA_NETGEAR_PHYSICAL_MAC=02:00:00:00:a0:01

# Optional stock HTTPS status reader (enroll the router certificate's DER SHA-256)
# OMADA_NETGEAR_DASHBOARD_CERT_SHA256=
# OMADA_NETGEAR_DASHBOARD_UPLINK=WAN

# Optional local JSON files from scripts/rs700_beacon_observer.py
# OMADA_NETGEAR_BEACON_FILE=/observations/receiver-1.json
# OMADA_NETGEAR_SECONDARY_BEACON_FILE=/observations/receiver-2.json

# Optional dedicated-switch-port octet file from scripts/observe-omada-uplink.py
# OMADA_NETGEAR_UPLINK_FILE=/observations/ap1-uplink.json

# Optional state and heartbeat file overrides
# OMADA_STATE_FILE=/state/agent-state.json
# OMADA_HEARTBEAT_FILE=/tmp/open-omada-heartbeat-020000000001.json
